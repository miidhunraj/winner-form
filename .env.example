PORT=3000
ADMIN_USER=admin
ADMIN_PASS=replace-with-a-long-random-password

# Google Sheets
GOOGLE_SHEETS_ID=your-google-spreadsheet-id
GOOGLE_SHEET_NAME=Giveaway Winners
# Prefer the base64-encoded service-account JSON for deployment. Never expose this in frontend code.
GOOGLE_SERVICE_ACCOUNT_JSON=BASE64_ENCODED_SERVICE_ACCOUNT_JSON

# Optional: comma-separated frontend origins if frontend is hosted separately.
ALLOWED_ORIGINS=

# Set true only if duplicate submissions are intentionally allowed.
ALLOW_DUPLICATES=false
